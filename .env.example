# Скопируйте в .env.local (локально) или задайте в Vercel → Settings → Environment Variables.

# ── Supabase ────────────────────────────────────────────────────────────────
# Нужен для Vercel и для нескольких устройств одновременно (Postgres + Realtime).
# Если оставить пустым — включается локальный режим: данные в памяти Next.js-сервера
# (+ файл .data/local-db.json), realtime через SSE. Удобно для зала без интернета.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только сервер. Все записи идут через API приложения с этим ключом (RLS для anon — только чтение).
SUPABASE_SERVICE_ROLE_KEY=

# Принудительно локальный режим, даже если Supabase задан (например, в зале нет сети):
# NEXT_PUBLIC_DATA_MODE=local

# ── AI для Table Mode (только сервер, никогда не на клиенте) ───────────────
# Пусто → эпизоды на готовом сиде и шаблонный итог. Демо работает и без ключа.
ANTHROPIC_API_KEY=
# Модель по умолчанию — актуальный Claude Sonnet:
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Админка Table Mode ──────────────────────────────────────────────────────
ADMIN_PIN=1234

# ── Тонкая настройка ────────────────────────────────────────────────────────
# Прогноз по броням: если в ближайшие 30 минут в зону придёт столько гостей — заранее убавить музыку
# FORECAST_GUESTS=16
# Файл локального режима
# LOCAL_DB_FILE=.data/local-db.json
